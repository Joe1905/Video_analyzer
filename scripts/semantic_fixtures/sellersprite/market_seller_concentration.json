          },
          "topN": {
            "type": "integer",
            "format": "int32",
            "description": "头部Listing数量, 做竞争分析时，一般是取头部产品和整体样本做对比，来判断市场竞争度/集中度, 卖家精灵默认是取头部前10商品"
          }
        },
        "required": [
          "marketplace",
          "nodeIdPath"
        ]
      }
    },
    "required": [
      "request"
    ],
    "additionalProperties": false
