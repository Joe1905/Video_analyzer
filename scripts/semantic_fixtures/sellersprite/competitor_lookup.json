{
  "provider": "sellersprite",
  "tool": "competitor_lookup",
  "contract_source": {
    "request": "2026-07-23运行时MCP Schema",
    "response": "工具专属Semantic契约与脱敏业务样本"
  },
  "semantic": {
    "title": "亚马逊商品竞品样本",
    "profile": "records",
    "entity_type": "asin",
    "report_included": true
  },
  "runtime_input_schema": {
    "type": "object",
    "properties": {
      "request": {
        "type": "object",
        "properties": {
          "asins": {
            "description": "asins, 最多只支持40个，如果超过40个, 需要拆分多次请求",
            "type": "array",
            "items": {
              "type": "string",
              "description": "asins, 最多只支持40个，如果超过40个, 需要拆分多次请求"
            }
          },
          "brand": {
            "type": "string",
            "description": "brand name"
          },
          "keyword": {
            "type": "string",
            "description": "关键字，基于商品标题进行匹配"
          },
          "keywordEqual": {
            "type": "boolean"
          },
          "marketplace": {
            "type": "string",
            "description": "Amazon 站点代码（枚举值）：US, JP, UK, DE, FR, IT, ES, CA, IN, MX, BR, AU, AE"
          },
          "matchType": {
            "type": "integer",
            "format": "int32",
            "description": "\"匹配方式, 默认: 2\n可选值(必须严格使用下列数字值之一):\n1: 词组匹配\n2: 模糊匹配\n3: 精准匹配\n\n禁止使用未列出的值。\n"
          },
          "month": {
            "type": "string",
            "description": "查询月份, 格式: yyyyMM"
          },
          "nodeIdPath": {
            "type": "string",
            "description": "产品所属的类目节点 ID, 例如： 2619525011:3741271， 通常通过查询【产品类目信息】获取，或由用户直接指定类目路径"
          },
          "nodeIdPathEqual": {
            "type": "boolean",
            "description": "类目节点查询方式"
          },
          "order": {
            "type": "object",
            "properties": {
              "desc": {
                "type": "boolean",
                "description": "排序类型"
              },
              "field": {
                "type": "string",
                "description": "排序字段。\n可选值(仅填写字段名):\n- total_units: 月销量\n- total_amount: 月销售额\n- price: 价格\n- rating: 评分\n- reviews: 评分数\n- profit: 毛利\n- reviews_rate: 留评率\n- available_date: 上架时间\n- questions: Q&A\n- total_units_growth: 月销量增长率\n- total_amount_growth: 月销售额增长率\n- reviews_increasement: 月新增评分数\n- bsr_rank_cv: 近7天BSR增长数\n- bsr_rank_cr: 近7天BSR增长率\n\n禁止使用未列出的值。\n"
              }
            },
            "description": "排序"
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "页码"
          },
          "returnFields": {
            "type": "string",
            "description": "指定返回的字段，多个字段用逗号隔开。不指定则返回所有字段。例如：asin,title,price,totalUnits,totalAmount"
          },
          "sellerName": {
            "type": "string",
            "description": "seller name"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "每页条数"
          },
          "variation": {
            "type": "string",
            "description": "是否查询变体ASIN，如果没有明确指定则要设置成: Y\n可选值(仅填写字段名):\n- Y: exclude\n- N: include\n"
          }
        },
        "required": [
          "marketplace"
        ]
      }
    },
    "required": [
      "request"
    ],
    "additionalProperties": false
  },
  "request_variants": [
    {
      "name": "运行时结构",
      "arguments": {
        "request": {
          "asins": [
            "B0TEST1234"
          ],
          "brand": "样例值",
          "keyword": "portable desk fan",
          "keywordEqual": true,
          "marketplace": "US",
          "matchType": 1,
          "month": "2026-06",
          "nodeIdPath": "样例值",
          "nodeIdPathEqual": true,
          "order": {
            "desc": true,
            "field": "样例值"
          },
          "page": 1,
          "returnFields": "asin",
          "sellerName": "样例值",
          "size": 1,
          "variation": "样例值"
        }
      }
    }
  ],
  "response_variants": {
    "success": {
      "data": {
        "total": 1,
        "list": [
          {
            "asin": "B0TEST1234",
            "title": "Portable Desk Fan",
            "rank": 1,
            "price": 24.99,
            "currency": "USD",
            "period": "2026-06"
          }
        ]
      }
    },
    "empty": {
      "data": {
        "total": 0,
        "list": []
      }
    },
    "error": {
      "success": false,
      "message": "样例调用失败"
    },
    "partial_identity": {
      "data": {
        "total": 1,
        "list": [
          {
            "asin": "B0TEST1234",
            "title": "Portable Desk Fan",
            "rank": 1,
            "price": 24.99,
            "currency": "USD",
            "period": "2026-06"
          },
          {
            "price": 19.99,
            "currency": "USD"
          }
        ]
      }
    }
  },
  "documented_response_fields": [
    "asin",
    "currency",
    "period",
    "price",
    "rank",
    "title",
    "total"
  ],
  "expected_semantic": [
    "亚马逊商品竞品样本"
  ],
  "forbidden_semantic": [
    "sellersprite__competitor_lookup",
    "call:",
    "null",
    "true",
    "false"
  ]
}
