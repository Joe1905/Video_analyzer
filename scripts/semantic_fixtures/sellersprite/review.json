{
  "provider": "sellersprite",
  "tool": "review",
  "contract_source": {
    "request": "2026-07-23运行时MCP Schema",
    "response": "工具专属Semantic契约与脱敏业务样本"
  },
  "semantic": {
    "title": "商品评论样本",
    "profile": "records",
    "entity_type": "review",
    "report_included": true
  },
  "runtime_input_schema": {
    "type": "object",
    "properties": {
      "marketplace": {
        "type": "string",
        "enum": [
          "US",
          "JP",
          "UK",
          "DE",
          "FR",
          "IT",
          "ES",
          "CA",
          "IN",
          "MX",
          "BR",
          "AU",
          "AE"
        ],
        "description": "Amazon 站点"
      },
      "asin": {
        "type": "string"
      },
      "starList": {
        "type": "array",
        "items": {
          "type": "integer",
          "format": "int32"
        },
        "description": "评论星级\n可选值(仅填写字段名):\n- 1: 一星\n- 2: 二星\n- 3: 三星\n- 4: 四星\n- 5: 五星\n"
      },
      "typeList": {
        "type": "array",
        "items": {
          "type": "integer",
          "format": "int32"
        },
        "description": "评论类型\n可选值(仅填写字段名):\n- 1：图片评论\n- 2：视频评论\n- 3：VP评论\n- 4：vine评论\n"
      },
      "page": {
        "type": "integer"
      },
      "size": {
        "type": "integer"
      },
      "startTimestamp": {
        "type": "integer",
        "description": "获取评论的开始时间毫秒"
      },
      "endTimestamp": {
        "type": "integer",
        "description": "获取评论的结束时间毫秒"
      },
      "returnFields": {
        "type": "string",
        "description": "指定返回的字段，多个字段用逗号隔开。不指定则返回所有字段。例如：asin"
      }
    },
    "required": [
      "marketplace",
      "asin"
    ],
    "additionalProperties": false
  },
  "request_variants": [
    {
      "name": "运行时结构",
      "arguments": {
        "marketplace": "US",
        "asin": "B0TEST1234",
        "starList": [
          1
        ],
        "typeList": [
          1
        ],
        "page": 1,
        "size": 1,
        "startTimestamp": 1,
        "endTimestamp": 1,
        "returnFields": "asin"
      }
    }
  ],
  "response_variants": {
    "success": {
      "data": {
        "total": 1,
        "list": [
          {
            "review_id": "R-1001",
            "review_content": "Quiet and convenient",
            "review_rating": 4,
            "rank": 1,
            "price": 24.99,
            "currency": "USD",
            "period": "2026-06"
          }
        ]
      }
    },
    "empty": {
      "data": {
        "total": 0,
        "list": []
      }
    },
    "error": {
      "success": false,
      "message": "样例调用失败"
    },
    "partial_identity": {
      "data": {
        "total": 1,
        "list": [
          {
            "review_id": "R-1001",
            "review_content": "Quiet and convenient",
            "review_rating": 4,
            "rank": 1,
            "price": 24.99,
            "currency": "USD",
            "period": "2026-06"
          },
          {
            "price": 19.99,
            "currency": "USD"
          }
        ]
      }
    }
  },
  "documented_response_fields": [
    "currency",
    "period",
    "price",
    "rank",
    "review_content",
    "review_id",
    "review_rating",
    "total"
  ],
  "expected_semantic": [
    "商品评论样本"
  ],
  "forbidden_semantic": [
    "sellersprite__review",
    "call:",
    "null",
    "true",
    "false"
