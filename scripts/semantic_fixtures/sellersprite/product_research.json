{
  "provider": "sellersprite",
  "tool": "product_research",
  "contract_source": {
    "request": "2026-07-23运行时MCP Schema",
    "response": "工具专属Semantic契约与脱敏业务样本"
  },
  "semantic": {
    "title": "商品研究样本",
    "profile": "records",
    "entity_type": "asin",
    "report_included": true
  },
  "runtime_input_schema": {
    "type": "object",
    "properties": {
      "request": {
        "type": "object",
        "properties": {
          "availableMonth": {
            "type": "integer",
            "format": "int32",
            "description": "上架月份"
          },
          "badgeAC": {
            "type": "string",
            "description": "是否有热销标识 Amazon's Choice"
          },
          "badgeBS": {
            "type": "string",
            "description": "是否有热销标识 Best Seller"
          },
          "badgeNR": {
            "type": "string",
            "description": "是否有新品标识 New Release"
          },
          "dimensionType": {
            "type": "string",
            "description": "尺寸类型集合,逗号分隔，默认不限制"
          },
          "excludeBrands": {
            "type": "string",
            "description": "排除品牌"
          },
          "excludeKeywords": {
            "type": "string",
            "description": "排除的关键字"
          },
          "excludeSellers": {
            "type": "string",
            "description": "排除卖家"
          },
          "filterSub": {
            "type": "string",
            "description": "是否筛选子类目，Y：是"
          },
          "fulfillment": {
            "type": "string",
            "description": "配送方式，多条件查询用逗号隔开"
          },
          "includeBrands": {
            "type": "string",
            "description": "包含品牌"
          },
          "includeSellers": {
            "type": "string",
            "description": "包含卖家"
          },
          "keyword": {
            "type": "string",
            "description": "关键字"
          },
          "marketplace": {
            "type": "string",
            "description": "Amazon 站点代码（枚举值）：US, JP, UK, DE, FR, IT, ES, CA, IN, MX, BR, AU, AE"
          },
          "matchType": {
            "type": "integer",
            "format": "int32",
            "description": "\"匹配方式, 默认: 2\n可选值(必须严格使用下列数字值之一):\n1: 词组匹配\n2: 模糊匹配\n3: 精准匹配\n\n禁止使用未列出的值。\n"
          },
          "maxAmzUnit": {
            "type": "integer",
            "format": "int32",
            "description": "最高子体月销量"
          },
          "maxBsr": {
            "type": "integer",
            "format": "int32",
            "description": "大类 BSR 最低排名"
          },
          "maxBsrCr": {
            "type": "number",
            "format": "float",
            "description": "BSR 最高增长率"
          },
          "maxBsrCv": {
            "type": "integer",
            "format": "int32",
            "description": "BSR 最高增长数"
          },
          "maxFba": {
            "type": "number",
            "format": "float",
            "description": "FBA 最高运费"
          },
          "maxLqs": {
            "type": "number",
            "format": "float",
            "description": "最高 Listing 页面质量分"
          },
          "maxPrice": {
            "type": "number",
            "format": "float",
            "description": "最高价格"
          },
          "maxProfit": {
            "type": "number",
            "format": "float",
            "description": "最大毛利率"
          },
          "maxRating": {
            "type": "number",
            "format": "float",
            "description": "最高评分值"
          },
          "maxRatings": {
            "type": "integer",
            "format": "int32",
            "description": "最高评分数"
          },
          "maxRatingsCv": {
            "type": "integer",
            "format": "int32",
            "description": "最高月新增评分数"
          },
          "maxRevenue": {
            "type": "number",
            "format": "float",
            "description": "最高月销售额"
          },
          "maxRevenueCr": {
            "type": "number",
            "format": "float",
            "description": "月销售额最高增长率"
          },
          "maxSellers": {
            "type": "integer",
            "format": "int32",
            "description": "最大卖家数量"
          },
          "maxSubBsrRank": {
            "type": "integer",
            "format": "int32",
            "description": "最大子类排名"
          },
          "maxUnits": {
            "type": "integer",
            "format": "int32",
            "description": "最高月销量"
          },
          "maxUnitsCr": {
            "type": "number",
            "format": "float",
            "description": "月销量最高增长率"
          },
          "maxVariations": {
            "type": "integer",
            "format": "int32",
            "description": "最高变体数"
          },
          "maxWeights": {
            "type": "number",
            "format": "float",
            "description": "最大重量"
          },
          "minAmzUnit": {
            "type": "integer",
            "format": "int32",
            "description": "最低子体月销量"
          },
          "minBsr": {
            "type": "integer",
            "format": "int32",
            "description": "大类 BSR 最高排名"
          },
          "minBsrCr": {
            "type": "number",
            "format": "float",
            "description": "BSR 最低增长率"
          },
          "minBsrCv": {
            "type": "integer",
            "format": "int32",
            "description": "BSR 最低增长数"
          },
          "minFba": {
            "type": "number",
            "format": "float",
            "description": "FBA 最低运费"
          },
          "minLqs": {
            "type": "number",
            "format": "float",
            "description": "最低 Listing 页面质量分"
          },
          "minPrice": {
            "type": "number",
            "format": "float",
            "description": "最低价格"
          },
          "minProfit": {
            "type": "number",
            "format": "float",
            "description": "最小毛利率"
          },
          "minRating": {
            "type": "number",
            "format": "float",
            "description": "最低评分值"
          },
          "minRatings": {
            "type": "integer",
            "format": "int32",
            "description": "最低评分数"
          },
          "minRatingsCv": {
            "type": "integer",
            "format": "int32",
            "description": "最低月新增评分数"
          },
          "minRevenue": {
            "type": "number",
            "format": "float",
            "description": "最低月销售额"
          },
          "minRevenueCr": {
            "type": "number",
            "format": "float",
            "description": "月销售额最低增长率"
          },
          "minSellers": {
            "type": "integer",
            "format": "int32",
            "description": "最小卖家数量"
          },
          "minSubBsrRank": {
            "type": "integer",
            "format": "int32",
            "description": "最小子类排名"
          },
          "minUnits": {
            "type": "integer",
            "format": "int32",
            "description": "最低月销量"
          },
          "minUnitsCr": {
            "type": "number",
            "format": "float",
            "description": "月销量最低增长率"
          },
          "minVariations": {
            "type": "integer",
            "format": "int32",
            "description": "最低变体数"
          },
          "minWeights": {
            "type": "number",
            "format": "float",
            "description": "最小重量"
          },
          "month": {
            "type": "string",
            "description": "查询月份, 格式: yyyyMM"
          },
          "nodeIdPath": {
            "type": "string",
            "description": "类目编号"
          },
          "nodeIdPathEqual": {
            "type": "boolean",
            "description": "true为类目精确查询 false为查询当前及子类目"
          },
          "nodeIdPaths": {
            "description": "类目节点字符串列表",
            "type": "array",
            "items": {
              "type": "string",
              "description": "类目节点字符串列表"
            }
          },
          "order": {
            "type": "object",
            "properties": {
              "desc": {
                "type": "boolean",
                "description": "排序类型"
              },
              "field": {
                "type": "string",
                "description": "排序字段。\n可选值(仅填写字段名):\n- total_units: 月销量\n- total_amount: 月销售额\n- price: 价格\n- rating: 评分\n- reviews: 评分数\n- profit: 毛利\n- reviews_rate: 留评率\n- available_date: 上架时间\n- questions: Q&A\n- total_units_growth: 月销量增长率\n- total_amount_growth: 月销售额增长率\n- reviews_increasement: 月新增评分数\n- bsr_rank_cv: 近7天BSR增长数\n- bsr_rank_cr: 近7天BSR增长率\n\n禁止使用未列出的值。\n"
              }
            },
            "description": "排序"
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "页码"
          },
          "returnFields": {
            "type": "string",
            "description": "指定返回的字段，多个字段用逗号隔开。不指定则返回所有字段。例如：asin,title,price,totalUnits,totalAmount"
          },
          "sellerNation": {
            "type": "string",
            "description": "卖家所属地, 默认不限制, 多个用逗号隔开\n可选值(仅填写字段名):\n- CN: 中国\n- HK: 中国香港\n- US: 美国\n- JP: 日本\n- GB: 英国\n- DE: 德国\n- FR: 法国\n- IT: 意大利\n- ES: 西班牙\n- CA: 加拿大\n- IN: 印度\n- TR: 土耳其\n- TW: 中国台湾\n- MX: 墨西哥\n- AU: 澳大利亚\n- AE: 阿联酋\n- BR: 巴西\n禁止使用未列出的值。\n"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "每页条数"
          },
          "variation": {
            "type": "string",
            "description": "是否查询变体ASIN，如果没有明确指定则要设置成: Y\n可选值(仅填写字段名):\n- Y: exclude\n- N: include\n"
          },
          "weightUnit": {
            "type": "string",
            "description": "重量单位，默认：g\n可选值(仅填写字段名):\n- g: 克\n- kg: 千克\n- ounces: 盎司\n- pounds: 磅\n禁止使用未列出的值。\n"
          }
        },
        "required": [
          "marketplace"
        ]
      }
    },
    "required": [
      "request"
    ],
    "additionalProperties": false
  },
