{
  "provider": "sellersprite",
  "tool": "keyword_order",
  "contract_source": {
    "request": "2026-07-23运行时MCP Schema",
    "response": "工具专属Semantic契约与脱敏业务样本"
  },
  "semantic": {
    "title": "关键词自然排名",
    "profile": "records",
    "entity_type": "keyword",
    "report_included": true
  },
  "runtime_input_schema": {
    "type": "object",
    "properties": {
      "request": {
        "type": "object",
        "properties": {
          "asins": {
            "description": "asin list",
            "type": "array",
            "items": {
              "type": "string",
              "description": "asin list"
            }
          },
          "conversionType": {
            "type": "string",
            "description": "转化类型\n可选值(仅填写字段名):\n- E: 转化优质词\n- S: 转化平稳词\n- L: 转化流失词\n- I: 无效曝光词\n"
          },
          "date": {
            "type": "string",
            "description": "回溯类型. 可选值: W/M. 当 reverseType = 'W' 时, date 必须为 yyyyMMdd 格式, 且表示当周的周六. 当 reverseType = 'M' 时, date 必须为 yyyyMM 格式."
          },
          "marketplace": {
            "type": "string",
            "description": "Amazon 站点代码（枚举值）：US, JP, UK, DE, FR, IT, ES, CA, IN, MX, BR, AU, AE"
          },
          "order": {
            "type": "object",
            "properties": {
              "desc": {
                "type": "boolean",
                "description": "排序类型"
              },
              "field": {
                "type": "string",
                "description": "排序字段。\n可选值(仅填写字段名):\n- searchRank: 搜索量\n- searchRankGrowthValue: 搜索量增长值\n- searchRankGrowthRate:搜索量增长率\n- sumClickRate: 点击率\n\n禁止使用未列出的值。\n"
              }
            },
            "description": "排序"
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "description": "页码"
          },
          "returnFields": {
            "type": "string",
            "description": "指定返回的字段，多个字段用逗号隔开。不指定则返回所有字段。例如：asin,title,price,totalUnits,totalAmount"
          },
          "reverseType": {
            "type": "string",
            "description": "反查模式\n可选值(仅填写字段名):\n- W: 周\n- M: 月\n"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "每页条数"
          },
          "variation": {
            "type": "string",
            "description": "是否查询变体ASIN\n可选值(仅填写字段名):\n- Y: exclude\n- N: include\n"
          }
        },
        "required": [
          "asins",
          "date",
          "marketplace",
          "reverseType"
        ]
      }
    },
    "required": [
      "request"
    ],
    "additionalProperties": false
  },
  "request_variants": [
    {
      "name": "运行时结构",
      "arguments": {
        "request": {
          "asins": [
            "B0TEST1234"
          ],
          "conversionType": "样例值",
          "date": "样例值",
          "marketplace": "US",
          "order": {
            "desc": true,
            "field": "样例值"
          },
          "page": 1,
          "returnFields": "asin",
          "reverseType": "样例值",
          "size": 1,
          "variation": "样例值"
        }
      }
    }
  ],
  "response_variants": {
    "success": {
      "data": {
        "total": 1,
        "list": [
          {
            "keywords": "portable desk fan",
            "rank": 1,
            "price": 24.99,
            "currency": "USD",
            "period": "2026-06",
            "search_volume": 12500,
            "purchase_volume": 1800,
            "purchase_rate": 0.144
          }
        ]
      }
    },
    "empty": {
      "data": {
        "total": 0,
        "list": []
      }
    },
    "error": {
      "success": false,
      "message": "样例调用失败"
    },
    "partial_identity": {
      "data": {
        "total": 1,
        "list": [
          {
            "keywords": "portable desk fan",
            "rank": 1,
            "price": 24.99,
            "currency": "USD",
            "period": "2026-06",
            "search_volume": 12500,
            "purchase_volume": 1800,
            "purchase_rate": 0.144
          },
          {
            "price": 19.99,
            "currency": "USD"
          }
        ]
      }
    }
  },
  "documented_response_fields": [
    "currency",
    "keywords",
    "period",
    "price",
    "purchase_rate",
    "purchase_volume",
    "rank",
    "search_volume",
