{
  "provider": "fastmoss",
  "tool": "creator_product_list",
  "contract_source": {
    "request": "2026-07-23运行时MCP Schema",
    "response": "工具专属Semantic契约与脱敏业务样本"
  },
  "semantic": {
    "title": "达人带货商品样本",
    "profile": "records",
    "entity_type": "creator",
    "report_included": true
  },
  "runtime_input_schema": {
    "properties": {
      "filter": {
        "description": "Filter parameters.",
        "properties": {
          "category_id": {
            "description": "First-level product category ID only; second-level or third-level category IDs are not supported.",
            "type": "integer"
          },
          "time_range_days": {
            "description": "Days: 7/14/28/90; recent=28; -1=cumulative.",
            "type": "string"
          },
          "uid": {
            "description": "Creator UID; use creator_search first if only a handle/nickname is known.",
            "type": "string"
          }
        },
        "required": [
          "uid"
        ],
        "type": "object"
      },
      "orderby": {
        "description": "Sort options. Only the first sort rule takes effect. Fields: units_sold, gmv, commission_rate_percent.",
        "items": {
          "properties": {
            "field": {
              "enum": [
                "units_sold",
                "gmv",
                "commission_rate_percent"
              ],
              "type": "string"
            },
            "order": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      },
      "page": {
        "default": 1,
        "description": "Page number. Default 1, max 500.",
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "pagesize": {
        "default": 10,
        "description": "Page size. Default 10, max 10.",
        "maximum": 10,
        "type": "integer"
      }
    },
    "required": [
      "filter"
    ],
    "type": "object"
  },
  "request_variants": [
    {
      "name": "运行时结构",
      "arguments": {
        "filter": {
