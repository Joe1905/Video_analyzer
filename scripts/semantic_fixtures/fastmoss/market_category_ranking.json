{
  "provider": "fastmoss",
  "tool": "market_category_ranking",
  "contract_source": {
    "request": "2026-07-23运行时MCP Schema",
    "response": "工具专属Semantic契约与脱敏业务样本"
  },
  "semantic": {
    "title": "市场类目排名",
    "profile": "records",
    "entity_type": "category",
    "report_included": true
  },
  "runtime_input_schema": {
    "properties": {
      "filter": {
        "description": "Filter parameters.",
        "properties": {
          "category_id": {
            "description": "Parent category ID. Only level-1 category IDs are supported; level-2 or level-3 category IDs are not supported. Omit it or set -100 for level-1 ranking, or pass a level-1 category for its level-2 ranking.",
            "type": "integer"
          },
          "date_type": {
            "description": "Ranking period: day, week, or month; MCN agency rankings support only week/month.",
            "type": "string"
          },
          "date_value": {
            "description": "Completed period only: yesterday YYYY-MM-DD, last week YYYY-ww or YYYY-Www, last month YYYY-MM; do not use the current period.",
            "type": "string"
          },
          "region": {
            "description": "Country or region code, e.g. US, UK, ID.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "lang": {
        "description": "Language. Default EN_US, optional ZH_CN.",
        "type": "string"
      },
      "orderby": {
        "description": "Sort options. Only the first sort rule takes effect. Use ranking fields such as category_units_sold.",
        "items": {
          "properties": {
            "field": {
              "enum": [
                "category_units_sold",
                "category_units_sold_yoy_percent",
                "category_gmv_yoy_percent",
                "top_50_products_units_sold_share_percent",
                "top_10_shops_units_sold_share_percent"
              ],
              "type": "string"
            },
            "order": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      },
      "page": {
        "default": 1,
        "description": "Page number. Default 1, max 500.",
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "pagesize": {
        "default": 10,
        "description": "Page size. Default 10, max 10.",
        "maximum": 10,
        "type": "integer"
      }
    },
    "type": "object"
  },
  "request_variants": [
    {
      "name": "运行时结构",
      "arguments": {
        "filter": {
          "category_id": 123456,
          "date_type": "样例值",
          "date_value": "样例值",
          "region": "US"
        },
        "lang": "样例值",
        "orderby": [
          {
            "field": "category_units_sold",
            "order": "asc"
          }
        ],
        "page": 1,
        "pagesize": 10
      }
    }
  ],
