{
  "provider": "fastmoss",
  "tool": "creator_search",
  "contract_source": {
    "request": "2026-07-23运行时MCP Schema",
    "response": "工具专属Semantic契约与脱敏业务样本"
  },
  "semantic": {
    "title": "达人搜索结果",
    "profile": "records",
    "entity_type": "creator",
    "report_included": true
  },
  "runtime_input_schema": {
    "properties": {
      "filter": {
        "description": "Filter parameters.",
        "properties": {
          "category_id": {
            "description": "Category ID; confirm category first if only a category name is known.",
            "type": "integer"
          },
          "creator_type": {
            "description": "Creator type: 1 personal, 2 shop.",
            "type": "integer"
          },
          "follower_age_type": {
            "description": "Follower age: 1=18-24, 2=25-34, 3=35+.",
            "type": "integer"
          },
          "follower_gender_type": {
            "description": "Follower gender type parameter.",
            "type": "integer"
          },
          "follower_range": {
            "description": "Follower count range: {\"min\": number, \"max\": number}.",
            "properties": {
              "max": {
                "description": "Maximum value.",
                "type": "number"
              },
              "min": {
                "description": "Minimum value.",
                "type": "number"
              }
            },
            "type": "object"
          },
          "is_ecommerce_creator": {
            "description": "Is ecommerce creator parameter.",
            "type": "boolean"
          },
          "is_mcn_creator": {
            "description": "Is mcn creator parameter.",
            "type": "boolean"
          },
          "region": {
            "description": "Country or region code, e.g. US, UK, ID.",
            "type": "string"
          },
          "uid": {
            "description": "Creator UID; use creator_search first if only a handle/nickname is known.",
            "type": "string"
          },
          "unique_id": {
            "description": "Unique id.",
            "type": "string"
          },
          "verify_type": {
            "description": "Verification type: 1 regular creators, 2 Blue V creators.",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "keywords": {
        "description": "Search keywords: product, shop, creator, video, live, or category terms.",
        "type": "string"
      },
      "orderby": {
        "description": "Sort options.",
        "items": {
          "properties": {
            "field": {
              "enum": [
                "follower_count",
                "day28_follower_count",
                "video_count",
                "video_avg_play_count",
                "video_avg_digg_count",
                "day28_units_sold",
                "day28_gmv"
              ],
              "type": "string"
            },
            "order": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      },
      "page": {
        "default": 1,
        "description": "Page number. Default 1, max 500.",
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "pagesize": {
        "default": 10,
        "description": "Page size. Default 10, max 10.",
        "maximum": 10,
        "type": "integer"
      }
    },
    "type": "object"
  },
  "request_variants": [
    {
      "name": "运行时结构",
      "arguments": {
        "filter": {
          "category_id": 123456,
          "creator_type": 1,
          "follower_age_type": 1,
          "follower_gender_type": 1,
          "follower_range": {
            "max": 1.0,
            "min": 1.0
          },
          "is_ecommerce_creator": true,
