              "video_gmv",
              "live_units_sold",
              "live_gmv",
              "showcase_units_sold",
              "showcase_gmv"
            ],
            "type": "string"
          },
          "start_date": {
            "description": "Start date, YYYY-MM-DD; must be supplied together with end_date.",
            "type": "string"
          },
          "time_range_days": {
            "default": 28,
            "description": "Time range in days. Allowed values: 7, 14, 28, 90; when start_date and end_date are both provided, they take precedence; default 28 applies only without that date pair.",
