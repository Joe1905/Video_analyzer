{
  "provider": "fastmoss",
  "tool": "shop_live_analysis",
  "contract_source": {
    "request": "2026-07-23运行时MCP Schema",
    "response": "工具专属Semantic契约与脱敏业务样本"
  },
  "semantic": {
    "title": "店铺直播分析",
    "profile": "relationship",
    "entity_type": "shop",
    "report_included": true
  },
  "runtime_input_schema": {
    "properties": {
      "filter": {
        "description": "Filter parameters.",
        "properties": {
          "end_date": {
            "description": "End date, YYYY-MM-DD.",
            "type": "string"
          },
          "is_shop": {
            "description": "Live type: 0 all, 1 shop live, 2 affiliate live.",
            "type": "integer"
          },
          "seller_id": {
            "description": "Shop seller_id; use shop_search first if only a shop name is known.",
            "type": "string"
          },
          "start_date": {
            "description": "Start date, YYYY-MM-DD.",
            "type": "string"
          },
          "time_range_days": {
            "description": "Days: 7/14/28/90; recent=28; -1=cumulative.",
            "enum": [
              7,
              28,
              90
            ],
            "type": "integer"
          }
        },
        "required": [
          "seller_id"
        ],
        "type": "object"
      },
      "orderby": {
        "description": "Sort options.",
        "items": {
          "properties": {
            "field": {
              "enum": [
                "start_time",
                "product_count",
                "total_user_count",
                "units_sold",
                "gmv"
              ],
              "type": "string"
            },
            "order": {
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": "array"
      },
      "page": {
        "default": 1,
        "description": "Page number. Default 1, max 500.",
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
      },
      "pagesize": {
        "default": 10,
        "description": "Page size. Default 10, max 10.",
        "maximum": 10,
        "type": "integer"
      }
    },
    "required": [
      "filter"
    ],
    "type": "object"
  },
  "request_variants": [
    {
      "name": "运行时结构",
      "arguments": {
        "filter": {
          "end_date": "2026-06-30",
          "is_shop": 1,
          "seller_id": "样例值",
          "start_date": "2026-06-01",
          "time_range_days": 7
        },
        "orderby": [
          {
            "field": "start_time",
            "order": "asc"
          }
        ],
        "page": 1,
        "pagesize": 10
      }
    }
  ],
  "response_variants": {
    "success": {
      "data": {
        "total": 1,
        "list": [
          {
            "shop_id": "7234567890123456789",
            "shop_name": "Sample Store",
            "rank": 1,
            "price": 24.99,
            "currency": "USD",
            "period": "2026-06",
            "live_gmv": 4800,
            "live_units_sold": 160
          }
        ]
      }
    },
    "empty": {
      "data": {
        "total": 0,
        "list": []
      }
    },
    "error": {
      "success": false,
      "message": "样例调用失败"
    },
    "partial_identity": {
      "data": {
        "total": 1,
        "list": [
          {
            "shop_id": "7234567890123456789",
            "shop_name": "Sample Store",
            "rank": 1,
            "price": 24.99,
            "currency": "USD",
            "period": "2026-06",
            "live_gmv": 4800,
            "live_units_sold": 160
          },
          {
            "price": 19.99,
            "currency": "USD"
          }
        ]
      }
    }
  },
  "documented_response_fields": [
    "currency",
    "live_gmv",
    "live_units_sold",
    "period",
    "price",
    "rank",
    "shop_id",
    "shop_name",
    "total"
  ],
  "expected_semantic": [
    "店铺直播分析"
  ],
  "forbidden_semantic": [
    "fastmoss__shop_live_analysis",
    "call:",
    "null",
    "true",
    "false"
  ]
}
