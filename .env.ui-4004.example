# 复制为 .env.ui-4004 后，在服务器上按需补齐现有 .env 中的 API 配置。
# 此文件不包含任何密钥，4004 使用独立的工作树与 data-dev/videos-dev/output-dev。
WEB_PORT=4004
ANALYZER_IMAGE=short-video-analyzer-ui-4004:latest
HOT_VIDEO_REPORT_SCHEDULER_ENABLED=0
UI4004_PROXY_POOL_PORT_START=19100
UI4004_PROXY_POOL_PORT_END=19199
LAN_HOST=192.168.1.254
REPORT_LAN_HOST=192.168.1.254
REPORT_LAN_PORT=4004
SOCIAVAULT_API_KEY=replace-with-existing-server-key
SOCIAVAULT_MCP_PORT=4103
SOCIAVAULT_MCP_CACHE_TTL_SECONDS=86400
SOCIAVAULT_MCP_COMMAND=sociavault-mcp
SOCIAVAULT_TOOL_ROUTER_MODE=shadow
SOCIAVAULT_TOOL_ROUTER_CONFIDENCE=0.80
UI4004_BUILD_PROXY=http://127.0.0.1:7890
